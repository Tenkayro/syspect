<UserControl
    x:Class="Syspect.App.Views.StartupServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Syspect.App.Views"
    Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Startup, Services &amp; Scheduled Tasks" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="Manage startup entries and third-party services with safety guardrails for WSL, DAW/iLok, VMware, and NVIDIA" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="72"
                             Height="4"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource SubtleSurfaceBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Button Content="Refresh" Click="RefreshButton_Click" IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <views:BannerControl Grid.Row="1"
                             Margin="0,0,0,10"
                             IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                             Severity="{Binding BannerSeverity}"
                             Message="{Binding BannerMessage}" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <RadioButton Style="{StaticResource TabPillRadioStyle}"
                             GroupName="StartupTabs"
                             Tag="0"
                             IsChecked="True"
                             Content="Startup Apps"
                             Checked="TabRadio_Checked" />
                <RadioButton Style="{StaticResource TabPillRadioStyle}"
                             GroupName="StartupTabs"
                             Tag="1"
                             Content="Third-Party Services"
                             Checked="TabRadio_Checked" />
                <RadioButton Style="{StaticResource TabPillRadioStyle}"
                             GroupName="StartupTabs"
                             Tag="2"
                             Content="Scheduled Tasks"
                             Checked="TabRadio_Checked" />
            </StackPanel>

            <TextBox Grid.Column="1"
                     VerticalAlignment="Center"
                     Style="{StaticResource PlaceholderTextBoxStyle}"
                     Tag="Filter by name, service, or path..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,12,0" />

            <CheckBox Grid.Column="2"
                      Style="{StaticResource ToggleSwitchCheckBoxStyle}"
                      Content="Active / Candidates Only"
                      IsChecked="{Binding OnlyActionable, Mode=TwoWay}"
                      VerticalAlignment="Center" />
        </Grid>

        <!-- Tab 0: Startup Apps -->
        <Border Grid.Row="3"
                Style="{StaticResource FluentCardStyle}"
                Padding="8"
                Visibility="{Binding IsStartupTab, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource CardListBoxStyle}" ItemsSource="{Binding FilteredStartup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                        Background="{StaticResource SubtleSurfaceBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <TextBlock Text="{Binding FallbackGlyph}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowFallbackGlyph, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Icon}"
                                               Width="24" Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding LocationLabel}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <Border Grid.Column="3"
                                        Style="{StaticResource StatusPillStyle}"
                                        HorizontalAlignment="Left"
                                        Background="{Binding IsEnabled, Converter={StaticResource BoolStatusBrush}}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <Button Grid.Column="4"
                                        Content="Toggle"
                                        Tag="{Binding}"
                                        IsEnabled="{Binding CanToggle}"
                                        Click="ToggleStartupButton_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Tab 1: Services -->
        <Border Grid.Row="3"
                Style="{StaticResource FluentCardStyle}"
                Padding="8"
                Visibility="{Binding IsServicesTab, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource CardListBoxStyle}" ItemsSource="{Binding FilteredServices}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                        Background="{StaticResource SubtleSurfaceBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <TextBlock Text="{Binding FallbackGlyph}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowFallbackGlyph, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Icon}"
                                               Width="24" Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CategoryNote}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Style="{StaticResource StatusPillStyle}"
                                        HorizontalAlignment="Left"
                                        Background="{Binding SafetyTier, Converter={StaticResource SafetyTierBrush}}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SafetyBadge}" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding StartModeDisplay}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding State}" Style="{StaticResource MutedCaptionStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Start/Stop" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="ToggleServiceStateButton_Click" Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                                    <Button Content="Manual" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="SetServiceManualButton_Click" Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                                    <Button Content="Disable" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="SetServiceDisabledButton_Click" Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                                    <Button Content="Auto" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="SetServiceAutoButton_Click" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Tab 2: Scheduled Tasks -->
        <Border Grid.Row="3"
                Style="{StaticResource FluentCardStyle}"
                Padding="8"
                Visibility="{Binding IsTasksTab, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource CardListBoxStyle}" ItemsSource="{Binding FilteredTasks}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                        Background="{StaticResource SubtleSurfaceBrush}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <Grid>
                                        <TextBlock Text="{Binding FallbackGlyph}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ShowFallbackGlyph, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{Binding Icon}"
                                               Width="24" Height="24"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding FullPath}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Action}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Note}"
                                               Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}"
                                               Foreground="{StaticResource CautionTextBrush}"
                                               FontSize="12"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Style="{StaticResource StatusPillStyle}"
                                        HorizontalAlignment="Left"
                                        Background="{Binding IsMissingTarget, Converter={StaticResource BoolStatusBrush}, ConverterParameter=Invert}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Toggle" Tag="{Binding}" Click="ToggleTaskButton_Click" Padding="10,5" FontSize="12" Margin="0,0,6,0" />
                                    <Button Content="Delete" Tag="{Binding}" Click="DeleteTaskButton_Click" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
