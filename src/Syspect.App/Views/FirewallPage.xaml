<UserControl
    x:Class="Syspect.App.Views.FirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Syspect.App.Views">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Firewall &amp; Security Audit" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Inspects Domain/Private/Public profiles, RDP/WinRM/SMB status, and orphaned inbound rules" Opacity="0.7" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="70"
                             Height="4"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Button Content="Rescan"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Click="RefreshButton_Click"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
                <Button Content="Clean Downloads / Legacy"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        Click="CleanupCandidatesButton_Click"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
                <Button Content="Delete Selected"
                        Padding="10,4"
                        Click="DeleteSelectedButton_Click"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <views:BannerControl Grid.Row="1"
                             Margin="0,0,0,8"
                             IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                             Severity="{Binding BannerSeverity}"
                             Message="{Binding BannerMessage}" />

        <GroupBox Grid.Row="2" Header="Profiles &amp; Security Status" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Column="0" ItemsSource="{Binding Profiles}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border CornerRadius="8"
                                            Padding="7,1"
                                            Background="{Binding Enabled, Converter={StaticResource BoolStatusBrush}}">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding InboundPolicy}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Network" FontSize="12" Opacity="0.7" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AuditResult.NetworkCategory, FallbackValue='-'}" FontWeight="SemiBold" Margin="0,0,0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RDP / WinRM" FontSize="12" Opacity="0.7" Margin="0,0,0,2" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="RDP: " />
                        <TextBlock Text="{Binding AuditResult.RdpEnabled, FallbackValue=False}" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="· WinRM: " />
                        <TextBlock Text="{Binding AuditResult.WinRmRunning, FallbackValue=False}" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Allow Rules" FontSize="12" Opacity="0.7" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuditResult.TotalEnabledInboundAllowRules, FallbackValue=0}" FontWeight="SemiBold" />
                </Grid>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Orphaned Rules (Missing Executable)">
                <DataGrid ItemsSource="{Binding OrphanedRules}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Rule Name" Binding="{Binding Rule.Name}" Width="1.2*" />
                        <DataGridTextColumn Header="Profiles" Binding="{Binding Rule.Profiles}" Width="135" />
                        <DataGridTemplateColumn Header="Tag" Width="125" SortMemberPath="Rule.TagLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="8,2"
                                            Margin="4,2"
                                            HorizontalAlignment="Left"
                                            Background="{Binding Rule.IsOrphaned, Converter={StaticResource BoolStatusBrush}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding Rule.TagLabel}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Program" Binding="{Binding Rule.Program}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Active Dev / Remote Rules (Public)">
                <DataGrid ItemsSource="{Binding PublicActiveRules}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rule Name" Binding="{Binding Name}" Width="1.2*" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90" />
                        <DataGridTextColumn Header="Profiles" Binding="{Binding Profiles}" Width="150" />
                        <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
