<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Syspect.App.Views.StartupServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Syspect.App.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Startup, Services &amp; Scheduled Tasks" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="Manage startup entries and third-party services with safety guardrails for WSL, DAW/iLok, VMware, and NVIDIA" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
                <Button Content="Refresh" Click="RefreshButton_Click" IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <SelectorBar x:Name="TabSelector" Grid.Column="0" SelectionChanged="TabSelector_SelectionChanged">
                <SelectorBarItem Text="Startup Apps" IsSelected="True" />
                <SelectorBarItem Text="Third-Party Services" />
                <SelectorBarItem Text="Scheduled Tasks" />
            </SelectorBar>

            <TextBox Grid.Column="1" VerticalAlignment="Center"
                     PlaceholderText="Filter by name, service, or path..."
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                          OnContent="Active / Candidates Only" OffContent="Show All"
                          IsOn="{x:Bind ViewModel.OnlyActionable, Mode=TwoWay}" />
        </Grid>

        <!-- Tab 0: Startup Apps -->
        <Border Grid.Row="3" Style="{StaticResource FluentCardStyle}" Padding="8"
                Visibility="{x:Bind ViewModel.IsStartupTab, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{x:Bind ViewModel.FilteredStartup}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StartupItemViewModel">
                        <Border Margin="0,2" Padding="12,10" CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{x:Bind ShowFallbackGlyph, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Command}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind LocationLabel}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" />

                                <Border Grid.Column="3" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left"
                                        Background="{x:Bind IsEnabled, Converter={StaticResource BoolStatusBrush}}">
                                    <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <Button Grid.Column="4" Content="Toggle" Tag="{x:Bind}"
                                        IsEnabled="{x:Bind CanToggle}" Click="ToggleStartupButton_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Tab 1: Services -->
        <Border Grid.Row="3" Style="{StaticResource FluentCardStyle}" Padding="8"
                Visibility="{x:Bind ViewModel.IsServicesTab, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{x:Bind ViewModel.FilteredServices}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ServiceEntryViewModel">
                        <Border Margin="0,2" Padding="12,10" CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{x:Bind ShowFallbackGlyph, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind CategoryNote}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left"
                                        Background="{x:Bind SafetyTier, Converter={StaticResource SafetyTierBrush}}">
                                    <TextBlock Text="{x:Bind SafetyBadge}" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StartModeDisplay}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind State}" Style="{StaticResource MutedCaptionStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="Start/Stop" Tag="{x:Bind}" IsEnabled="{x:Bind CanModify}" Click="ToggleServiceStateButton_Click" Padding="10,5" FontSize="12" />
                                    <Button Content="Manual" Tag="{x:Bind}" IsEnabled="{x:Bind CanModify}" Click="SetServiceManualButton_Click" Padding="10,5" FontSize="12" />
                                    <Button Content="Disable" Tag="{x:Bind}" IsEnabled="{x:Bind CanModify}" Click="SetServiceDisabledButton_Click" Padding="10,5" FontSize="12" />
                                    <Button Content="Auto" Tag="{x:Bind}" IsEnabled="{x:Bind CanModify}" Click="SetServiceAutoButton_Click" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Tab 2: Scheduled Tasks -->
        <Border Grid.Row="3" Style="{StaticResource FluentCardStyle}" Padding="8"
                Visibility="{x:Bind ViewModel.IsTasksTab, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{x:Bind ViewModel.FilteredTasks}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduledTaskViewModel">
                        <Border Margin="0,2" Padding="12,10" CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="15"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{x:Bind ShowFallbackGlyph, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind FullPath}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Action}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind Note, Converter={StaticResource NotEmptyToVis}}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" />
                                </StackPanel>

                                <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left"
                                        Background="{x:Bind IsMissingTarget, Converter={StaticResource BoolStatusBrush}, ConverterParameter=Invert}">
                                    <TextBlock Text="{x:Bind StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="Toggle" Tag="{x:Bind}" Click="ToggleTaskButton_Click" Padding="10,5" FontSize="12" />
                                    <Button Content="Delete" Tag="{x:Bind}" Click="DeleteTaskButton_Click" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
