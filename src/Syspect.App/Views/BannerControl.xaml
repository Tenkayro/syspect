<UserControl
    x:Class="Syspect.App.Views.BannerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <Border Visibility="{Binding IsOpen, ElementName=Root, Converter={StaticResource BoolToVis}}"
            Background="{Binding Severity, ElementName=Root, Converter={StaticResource BannerBrush}, ConverterParameter=Background}"
            BorderBrush="{Binding Severity, ElementName=Root, Converter={StaticResource BannerBrush}, ConverterParameter=Border}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="10,7"
            Margin="0,0,0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Message, ElementName=Root}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="×"
                    Padding="8,2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click" />
        </Grid>
    </Border>
</UserControl>
