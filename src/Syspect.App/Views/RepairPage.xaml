<UserControl
    x:Class="Syspect.App.Views.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Syspect.App.Views"
    Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Repair &amp; Integrity Pipeline" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="Ordered execution: SSD &amp; chkdsk /scan → DISM (Check/Scan/Restore) → SFC → ComponentCleanup" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Schedule chkdsk C: /f"
                        Margin="0,0,8,0"
                        Click="ScheduleChkdskButton_Click"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}" />
                <Button Content="Cancel"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <Button Content="Run Smart Pipeline"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="StartButton_Click"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <views:BannerControl Grid.Row="1"
                             Margin="0,0,0,10"
                             IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                             Severity="{Binding BannerSeverity}"
                             Message="{Binding BannerMessage}" />

        <!-- Top Telemetry & Progress Card -->
        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentStepText}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource MutedCaptionStyle}"
                               Text="{Binding ElapsedStatusText}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Height="5"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource SubtleSurfaceBrush}"
                             Value="{Binding ProgressPercent}" />

                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     IsIndeterminate="True"
                                     Width="34"
                                     Height="3"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SubtleSurfaceBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LiveActivityText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding LiveMetricsText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="3"
                                 Margin="0,5,0,0"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource SubtleSurfaceBrush}"
                                 Value="{Binding DownloadProgressPercent}"
                                 Visibility="{Binding HasDownloadProgress, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Split: Step Checklist + Console/CBS -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="10">
                <ListBox Style="{StaticResource CardListBoxStyle}" ItemsSource="{Binding Steps}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ItemCardStyle}" Margin="0,0,0,8" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,8,0" />

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Code: " FontSize="11" Style="{StaticResource MutedCaptionStyle}" />
                                            <TextBlock Text="{Binding ExitCodeText}" FontSize="11" Style="{StaticResource MutedCaptionStyle}" Margin="0,0,12,0" />
                                            <TextBlock Text="Duration: " FontSize="11" Style="{StaticResource MutedCaptionStyle}" />
                                            <TextBlock Text="{Binding DurationText}" FontSize="11" Style="{StaticResource MutedCaptionStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource StatusPillStyle}"
                                            Background="{Binding State, Converter={StaticResource RepairStateBrush}}">
                                        <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="195" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource FluentCardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Live Console &amp; Background Activity (DISM / CBS / SFC / chkdsk)"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0,0,0,8" />
                        <Border Grid.Row="1"
                                Background="{StaticResource ConsoleBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBox x:Name="ConsoleTextBox"
                                     Style="{StaticResource SelectableConsoleTextBoxStyle}"
                                     Text="{Binding ConsoleText, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Windows CBS.log Summary" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                            <Button Content="Refresh CBS" HorizontalAlignment="Right" Padding="10,4" FontSize="12" Click="RefreshCbsButton_Click" />
                        </Grid>
                        <Border Grid.Row="1"
                                Background="{StaticResource ConsoleBackgroundBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBox Style="{StaticResource SelectableConsoleTextBoxStyle}"
                                     Padding="10"
                                     Text="{Binding CbsReport.RawSummaryText, Mode=OneWay, FallbackValue='Loading CBS.log...'}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
