<UserControl
    x:Class="Syspect.App.Views.StartupServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Syspect.App.Views">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Startup, Services &amp; Scheduled Tasks" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Manage startup entries and third-party services with safety guardrails for WSL, DAW/iLok, VMware, and NVIDIA" Opacity="0.7" FontSize="12" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="70"
                             Height="4"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Button Content="Refresh"
                        Padding="10,4"
                        Click="RefreshButton_Click"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <views:BannerControl Grid.Row="1"
                             Margin="0,0,0,8"
                             IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                             Severity="{Binding BannerSeverity}"
                             Message="{Binding BannerMessage}" />

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Filter:"
                       VerticalAlignment="Center"
                       Opacity="0.75"
                       Margin="0,0,6,0" />
            <TextBox Grid.Column="1"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,12,0" />
            <CheckBox Grid.Column="2"
                      Content="Active / Candidates only"
                      IsChecked="{Binding OnlyActionable, Mode=TwoWay}"
                      VerticalAlignment="Center" />
        </Grid>

        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Tab 0: Startup Apps -->
            <TabItem Header="Startup Apps">
                <DataGrid ItemsSource="{Binding FilteredStartup}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Application" Width="240" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                        <Image Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Location" Binding="{Binding LocationLabel}" Width="160" />
                        <DataGridTemplateColumn Header="Status" Width="95" SortMemberPath="StatusLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="8,2"
                                            Margin="4,2"
                                            HorizontalAlignment="Left"
                                            Background="{Binding IsEnabled, Converter={StaticResource BoolStatusBrush}}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" />
                        <DataGridTemplateColumn Header="Action" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Toggle"
                                            Tag="{Binding}"
                                            IsEnabled="{Binding CanToggle}"
                                            Padding="8,2"
                                            Margin="2"
                                            FontSize="11"
                                            Click="ToggleStartupButton_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 1: Services -->
            <TabItem Header="Third-Party Services">
                <DataGrid ItemsSource="{Binding FilteredServices}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Service" Width="240" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                        <Image Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Safety" Width="125" SortMemberPath="SafetyBadge">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="8,2"
                                            Margin="4,2"
                                            HorizontalAlignment="Left"
                                            Background="{Binding SafetyTier, Converter={StaticResource SafetyTierBrush}}">
                                        <TextBlock Text="{Binding SafetyBadge}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Startup" Binding="{Binding StartModeDisplay}" Width="95" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="85" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding CategoryNote}" Width="*" />
                        <DataGridTemplateColumn Header="Actions" Width="265">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Button Content="Start/Stop" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="ToggleServiceStateButton_Click" Padding="7,2" FontSize="11" Margin="0,0,4,0" />
                                        <Button Content="Manual" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="SetServiceManualButton_Click" Padding="7,2" FontSize="11" Margin="0,0,4,0" />
                                        <Button Content="Disable" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="SetServiceDisabledButton_Click" Padding="7,2" FontSize="11" Margin="0,0,4,0" />
                                        <Button Content="Auto" Tag="{Binding}" IsEnabled="{Binding CanModify}" Click="SetServiceAutoButton_Click" Padding="7,2" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 2: Scheduled Tasks -->
            <TabItem Header="Scheduled Tasks">
                <DataGrid ItemsSource="{Binding FilteredTasks}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Task" Width="250" SortMemberPath="FullPath">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                        <Image Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Margin="0,0,8,0"
                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding FullPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="135" SortMemberPath="StatusLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="8,2"
                                            Margin="4,2"
                                            HorizontalAlignment="Left"
                                            Background="{Binding IsMissingTarget, Converter={StaticResource BoolStatusBrush}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="180" />
                        <DataGridTemplateColumn Header="Actions" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Button Content="Toggle" Tag="{Binding}" Click="ToggleTaskButton_Click" Padding="8,2" FontSize="11" Margin="0,0,4,0" />
                                        <Button Content="Delete" Tag="{Binding}" Click="DeleteTaskButton_Click" Padding="8,2" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
