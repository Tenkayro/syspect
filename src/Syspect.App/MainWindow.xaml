<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Syspect.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="syspect">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/syspect.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="syspect" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Windows 11 Diagnostics · tenkayro.de" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="UpdateAvailableButton"
                        Click="UpdateAvailableButton_Click"
                        Visibility="Collapsed"
                        Padding="10,4"
                        FontSize="12"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="12" />
                        <TextBlock x:Name="UpdateAvailableText" Text="Update available" />
                    </StackPanel>
                </Button>
                <Border x:Name="AdminBadge" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock x:Name="AdminBadgeText" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <Button x:Name="ElevateButton"
                        Content="Restart as Admin"
                        Click="ElevateButton_Click"
                        Visibility="Collapsed"
                        Padding="10,4"
                        FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Navigation Shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="230"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="Dashboard" Icon="Home" />
                <NavigationViewItem Content="Repair" Tag="Repair" Icon="Repair" />
                <NavigationViewItem Content="Drivers" Tag="Drivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Startup &amp; Services" Tag="StartupServices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Firewall" Tag="Firewall">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Logs &amp; CBS" Tag="Logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Padding="24,16,24,24" />
        </NavigationView>
    </Grid>
</Window>
