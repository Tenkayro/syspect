<UserControl
    x:Class="Syspect.App.Views.FirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Syspect.App.Views"
    Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Firewall &amp; Security Audit" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="Inspects Domain/Private/Public profiles, RDP/WinRM/SMB status, and orphaned inbound rules" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="72"
                             Height="4"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource SubtleSurfaceBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Button Content="Rescan"
                        Margin="0,0,8,0"
                        Click="RefreshButton_Click"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
                <Button Content="Clean Downloads / Legacy"
                        Margin="0,0,8,0"
                        Click="CleanupCandidatesButton_Click"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
                <Button Content="Delete Selected"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="DeleteSelectedButton_Click"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <views:BannerControl Grid.Row="1"
                             Margin="0,0,0,10"
                             IsOpen="{Binding IsBannerOpen, Mode=TwoWay}"
                             Severity="{Binding BannerSeverity}"
                             Message="{Binding BannerMessage}" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="10">
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="4,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource StatusPillStyle}"
                                                HorizontalAlignment="Right"
                                                Background="{Binding Enabled, Converter={StaticResource BoolStatusBrush}}">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding InboundPolicy}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Network" Style="{StaticResource MutedCaptionStyle}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AuditResult.NetworkCategory, FallbackValue='-'}" FontWeight="SemiBold" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RDP / WinRM" Style="{StaticResource MutedCaptionStyle}" Margin="0,0,0,4" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="RDP: " />
                        <TextBlock Text="{Binding AuditResult.RdpEnabled, FallbackValue=False}" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock Text="· WinRM: " />
                        <TextBlock Text="{Binding AuditResult.WinRmRunning, FallbackValue=False}" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Allow Rules" Style="{StaticResource MutedCaptionStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuditResult.TotalEnabledInboundAllowRules, FallbackValue=0}" FontWeight="SemiBold" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Style="{StaticResource TabPillRadioStyle}"
                         GroupName="FirewallTabs"
                         Tag="0"
                         IsChecked="True"
                         Content="Orphaned Rules (Missing Executable)"
                         Checked="FwTabRadio_Checked" />
            <RadioButton Style="{StaticResource TabPillRadioStyle}"
                         GroupName="FirewallTabs"
                         Tag="1"
                         Content="Active Dev / Remote Rules (Public)"
                         Checked="FwTabRadio_Checked" />
        </StackPanel>

        <Border Grid.Row="4"
                Style="{StaticResource FluentCardStyle}"
                Padding="8"
                Visibility="{Binding IsOrphanedTab, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource CardListBoxStyle}" ItemsSource="{Binding OrphanedRules}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardStyle}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Rule.Name}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Rule.Program}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Rule.Profiles}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <Border Grid.Column="3"
                                        Style="{StaticResource StatusPillStyle}"
                                        HorizontalAlignment="Right"
                                        Background="{Binding Rule.IsOrphaned, Converter={StaticResource BoolStatusBrush}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding Rule.TagLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource FluentCardStyle}"
                Padding="8"
                Visibility="{Binding IsPublicTab, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource CardListBoxStyle}" ItemsSource="{Binding PublicActiveRules}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardStyle}" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding Program}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Protocol}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Profiles}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
