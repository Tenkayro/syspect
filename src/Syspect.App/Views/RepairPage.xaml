<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Syspect.App.Views.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Syspect.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Repair &amp; Integrity Pipeline" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="Ordered execution: SSD &amp; chkdsk /scan → DISM (Check/Scan/Restore) → SFC → ComponentCleanup" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Schedule chkdsk C: /f"
                        Click="ScheduleChkdskButton_Click"
                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvBool}}" />
                <Button Content="Cancel"
                        Click="CancelButton_Click"
                        Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <Button Content="Run Smart Pipeline"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="StartButton_Click"
                        IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="14,10">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.CurrentStepText, Mode=OneWay}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource MutedCaptionStyle}"
                               Text="{x:Bind ViewModel.ElapsedStatusText, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />

                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing Grid.Column="0"
                                      Width="14" Height="14"
                                      IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                      VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.LiveActivityText, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.LiveMetricsText, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="3"
                                 Value="{x:Bind ViewModel.DownloadProgressPercent, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.HasDownloadProgress, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepairStepItemViewModel">
                                <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay, Converter={StaticResource BoolToNullableBool}}" MinWidth="0" Padding="0" VerticalAlignment="Top" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind SummaryText, Mode=OneWay}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Code:" FontSize="11" Style="{StaticResource MutedCaptionStyle}" />
                                                    <TextBlock Text="{x:Bind ExitCodeText, Mode=OneWay}" FontSize="11" Style="{StaticResource MutedCaptionStyle}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Duration:" FontSize="11" Style="{StaticResource MutedCaptionStyle}" />
                                                    <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11" Style="{StaticResource MutedCaptionStyle}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}"
                                                Background="{x:Bind State, Mode=OneWay, Converter={StaticResource RepairStateBrush}}">
                                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource FluentCardStyle}" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Live Console &amp; Background Activity (DISM / CBS / SFC / chkdsk)" Style="{StaticResource CardTitleStyle}" />
                        <ScrollViewer x:Name="ConsoleScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                      CornerRadius="6" Padding="12">
                            <TextBlock Text="{x:Bind ViewModel.ConsoleText, Mode=OneWay}"
                                       FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource FluentCardStyle}" Padding="12">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="Windows CBS.log Summary" Style="{StaticResource CardTitleStyle}" />
                            <Button Content="Refresh CBS" HorizontalAlignment="Right" Padding="10,4" FontSize="12" Click="RefreshCbsButton_Click" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{x:Bind ViewModel.CbsReport.RawSummaryText, Mode=OneWay, FallbackValue='Loading CBS.log...'}"
                                       FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
