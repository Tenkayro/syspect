<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Syspect.App.Views.FirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Firewall &amp; Security Audit" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="Inspects Domain/Private/Public profiles, RDP/WinRM/SMB status, and orphaned inbound rules" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
                <Button Content="Rescan" Click="RefreshButton_Click" IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvBool}}" />
                <Button Content="Clean Downloads / Legacy" Click="CleanupCandidatesButton_Click" IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvBool}}" />
                <Button Content="Delete Selected" Style="{StaticResource AccentButtonStyle}" Click="DeleteSelectedButton_Click" IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.BannerSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="12">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="185" Padding="10" CornerRadius="6"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Right"
                                                Background="{Binding Enabled, Converter={StaticResource BoolStatusBrush}}">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding InboundPolicy}" Style="{StaticResource MutedCaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" Padding="12">
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Network" Style="{StaticResource MutedCaptionStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.AuditResult.NetworkCategory, Mode=OneWay, FallbackValue='-'}" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="RDP / WinRM" Style="{StaticResource MutedCaptionStyle}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="RDP:" />
                        <TextBlock Text="{x:Bind ViewModel.AuditResult.RdpEnabled, Mode=OneWay, FallbackValue=False}" FontWeight="SemiBold" />
                        <TextBlock Text="· WinRM:" />
                        <TextBlock Text="{x:Bind ViewModel.AuditResult.WinRmRunning, Mode=OneWay, FallbackValue=False}" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Active Allow Rules" Style="{StaticResource MutedCaptionStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.AuditResult.TotalEnabledInboundAllowRules, Mode=OneWay, FallbackValue=0}" FontWeight="SemiBold" />
                </Grid>
            </Border>
        </Grid>

        <SelectorBar x:Name="FwTabSelector" Grid.Row="3" SelectionChanged="FwTabSelector_SelectionChanged">
            <SelectorBarItem Text="Orphaned Rules (Missing Executable)" IsSelected="True" />
            <SelectorBarItem Text="Active Dev / Remote Rules (Public)" />
        </SelectorBar>

        <Border Grid.Row="4" Style="{StaticResource FluentCardStyle}" Padding="8"
                Visibility="{x:Bind ViewModel.IsOrphanedTab, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{x:Bind ViewModel.OrphanedRules}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="10,8" CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" MinWidth="0" Padding="0" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Rule.Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Rule.Program}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Rule.Profiles}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" />

                                <Border Grid.Column="3" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Right"
                                        Background="{Binding Rule.IsOrphaned, Converter={StaticResource BoolStatusBrush}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding Rule.TagLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource FluentCardStyle}" Padding="8"
                Visibility="{x:Bind ViewModel.IsPublicTab, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ListView ItemsSource="{x:Bind ViewModel.PublicActiveRules}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="10,8" CornerRadius="6"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Program}" Style="{StaticResource MutedCaptionStyle}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Protocol}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Profiles}" Style="{StaticResource MutedCaptionStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
