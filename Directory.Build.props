<Project>
  <PropertyGroup>
    <Version>0.1.2</Version>
    <Authors>Tenkayro</Authors>
    <Company>Tenkayro</Company>
    <Product>syspect</Product>
    <Copyright>Copyright © Tenkayro</Copyright>
    <PackageProjectUrl>https://tenkayro.de</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Tenkayro/syspect</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuildInParallel>true</BuildInParallel>
    <UseSharedCompilation>true</UseSharedCompilation>
  </PropertyGroup>
</Project>
