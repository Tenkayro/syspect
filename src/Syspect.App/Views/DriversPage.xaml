<UserControl
    x:Class="Syspect.App.Views.DriversPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Syspect.App.Views"
    Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Drivers &amp; Device Status" Style="{StaticResource PageHeaderStyle}" />
                <TextBlock Text="Inspects PnP error codes, signed drivers, and generic Microsoft inbox driver hints" Style="{StaticResource MutedCaptionStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="72"
                             Height="4"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource SubtleSurfaceBrush}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <Button Content="Rescan" Click="RefreshButton_Click" IsEnabled="{Binding IsLoading, Converter={StaticResource InvBool}}" />
            </StackPanel>
        </Grid>

        <views:BannerControl Grid.Row="1"
                             Margin="0,0,0,10"
                             IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                             Severity="Error"
                             Message="{Binding ErrorMessage}" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Problem Devices" Style="{StaticResource MutedCaptionStyle}" />
                    <TextBlock Text="{Binding ProblemCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Generic Driver Hints" Style="{StaticResource MutedCaptionStyle}" />
                    <TextBlock Text="{Binding HintCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource FluentCardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="Scanned Drivers" Style="{StaticResource MutedCaptionStyle}" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                      MinWidth="210"
                      Margin="0,0,12,0">
                <ComboBoxItem Content="All Scanned Drivers" />
                <ComboBoxItem Content="Hints &amp; Errors Only" />
                <ComboBoxItem Content="Core Hardware Only" />
            </ComboBox>
            <TextBox Grid.Column="1"
                     Style="{StaticResource PlaceholderTextBoxStyle}"
                     Tag="Search by device, class, provider, or INF..."
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource FluentCardStyle}" Padding="8">
            <ListBox Style="{StaticResource CardListBoxStyle}" ItemsSource="{Binding FilteredDrivers}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="125" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding DeviceClass}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProviderName}" Style="{StaticResource MutedCaptionStyle}" />
                                        <TextBlock Text=" · " Style="{StaticResource MutedCaptionStyle}" />
                                        <TextBlock Text="{Binding InfName}" Style="{StaticResource MutedCaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding HintMessage}"
                                               Visibility="{Binding HintMessage, Converter={StaticResource NotEmptyToVis}}"
                                               Foreground="{StaticResource CautionTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding DriverVersion}" FontFamily="Consolas" FontSize="12" />
                                    <TextBlock Text="{Binding DriverDate}" Style="{StaticResource MutedCaptionStyle}" />
                                </StackPanel>

                                <Border Grid.Column="3"
                                        Style="{StaticResource StatusPillStyle}"
                                        HorizontalAlignment="Right"
                                        Background="{Binding HasAnyIssue, Converter={StaticResource BoolStatusBrush}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
